    {
      "id": "contemporary-house",
      "name": "Contemporary House: Real-Time Architectural Walkthrough",
      "category": "interactive-experiences",
      
      "shortDescription": "An explorable contemporary home built for the browser in Three.js, with first-person navigation and an extensively optimised 3D environment.",
      "heroImage": "media/contemporary-house/hero2.png",
      
      "tools": ["Three.js", "Blender", "Real-Time 3D"],

      "process": [
      {
        "type": "text",
        "text": "I developed an interactive architectural walkthrough in Three.js, turning a contemporary house into an environment visitors can explore freely from a first-person perspective."
      },
      {
        "type": "video",
        "src": "media/contemporary-house/turntable.mp4",
        
        "caption": "A turntable of the house"
      },
      {
        "type": "text",
        "text": "A major focus was preparing and optimising the environment for real-time use in the browser. I brought triangle counts down from 15M to 3.86M."
      },

      {
        "type": "video",
        "src": "media/contemporary-house/walkthrough.mp4",
        
        "caption": "The Walkthrough"
      },
      {
        "type": "text",
        "text": "First-person movement lets visitors choose their own route and viewpoint, exploring the house as a connected space. The house was modelled, textured, and optimised by me directly from floor plans and elevation maps."
      },
      {
        "type": "text",
        "text": "I designed the interiors of the space to match the contemporary exterior."
      },
      {
        "type": "image",
        "src": "media/contemporary-house/iso2.png",
        "alt": "Isometric"
