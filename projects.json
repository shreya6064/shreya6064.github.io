      "id": "plant-growth",
      "name": "Generative Plant Growth System",
      "category": "procedural-systems",
      
      "shortDescription": "Plant growth system with artist controllable parameters to let you draw curves and animate plant growth along them",
      "heroImage": "media/plant-growth/hero.png",
      
      "tools": ["Blender", "Geometry Nodes"],

      "process": [
        {
        "type": "video",
        "src": "media/plant-growth/plant-growth.mp4",
        
        "caption": "Created by animating a single parameter from 0-1."
      },
      {
        "type": "video",
        "src": "media/plant-growth/suzanne.mp4",
        
        "caption": "Animated curves drawn on a surface."
      },


      {
        
        "type": "image",
        "src": "media/plant-growth/parameters.png",
        "caption": "Controllable Parameters"
      },
      
      {
        "type": "text",
        "text": "I made a procedural plant growth tool in Blender, with artist-controllable stem growth, leaf placement & density, leaf mesh, noise control, and stem & leaf size controls. Lets you draw to spawn vines along curves and use a 0-1 slider to grow them. The leaf size and placement changes as the vine grows. "
      },

      {
        "type": "video",
        "src": "media/plant-growth/tool-demo.mp4",
        
        "caption": "The tool in action."
      }
       
