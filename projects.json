    {
      "id": "casa-de-minas",
      "name": "Casa de Minas: Interactive Tour",
      "category": "interactive-experiences",
      
      "shortDescription": "A complete 3D recreation of Studio MK27’s Casa de Minas, featuring detailed landscaping, architectural renders, and a browser-based panoramic tour with interactive hotspots.",
      "heroImage": "media/casa-de-minas/1.png",
      
      "tools": ["JavaScript", "Blender", "360° Tour"],

      "process": [
      {
        "type": "text",
        "text": "I recreated the house and its surrounding landscape in Blender, developing the scene from architectural modelling through materials, lighting, and final rendering. The project combines exterior and interior views, elevated orthographic renders, and an interactive panoramic tour that lets visitors explore the spaces directly in their browser."
      },
      {
        "type": "image",
        "src": "media/casa-de-minas/3.png",
        "alt": "Isometric"
      },   
      
      {
        "type": "text",
        "text": "I created the house, interiors, pool, terraces, and surrounding landscape, bringing the architecture and its setting together in one complete scene. Particular attention went to the relationship between the building’s stacked volumes, open terraces, and densely planted hillside."
      },

      {
        "type": "image",
        "src": "media/casa-de-minas/5.png",
        "alt": "Isometric"
      },

      {
        "type": "text",
        "text": "I integrated pre-rendered 360° panoramas into a JavaScript web experience using a panorama viewer library. Visitors can look around each viewpoint, move between connected locations, and click information hotspots to learn about features within the scene."
      }
      
       
    ],

